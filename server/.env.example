# --- Trading 전용 네임스페이스 (shopping / homepage / jj-admin 과 분리) ---
# ORBITALPHA_TRADING_COMPANY_ID=orbitalpha
# ORBITALPHA_TRADING_SERVICE_ID=trading
# 메인 거래량 비율 (직전 20봉 평균 대비). 보조 비교 0.95 / 0.75는 고정.
# ORBITALPHA_TRADING_VOLUME_THRESHOLD_MAIN=1.15
# (선택) paper surge_scanner 포지션 시간청산(분). 기본 30. 10~180. 그 외 paper·실거래 timeout(10분) 불변.
# Paper 슬롯: normal / early 분리 (미설정 시 각 2). 총 동시 포지션 상한은 합(기본 4).
# PAPER_NORMAL_MAX_OPEN=2
# PAPER_EARLY_ENTRY_MAX_OPEN=2
# 하위 호환: PAPER_MAX_OPEN 만 있으면 PAPER_NORMAL_MAX_OPEN 기본값으로 사용
# Paper near-high: 초입(fresh·저추격·거래량)일 때만 timing near_high 단독 차단 완화
# PAPER_NEAR_HIGH_EARLY_BYPASS_SECONDS=8
# PAPER_NEAR_HIGH_EARLY_BYPASS_MAX_CHASE_PCT=0.25
# PAPER_NEAR_HIGH_EARLY_BYPASS_MIN_VOLUME_RATIO=1.2
# PAPER_SURGE_SCANNER_TIMEOUT_MINUTES=30
# paper pump 2단계 진입 — 손절(%). 미설정 시 -0.75. 허용 범위 -0.5 ~ -1 로 clamp.
# PAPER_SURGE_STOP_LOSS_PCT=-0.75
# pump 1차 선진입: 직전 20봉 대비 거래량 배수 최소(기본 1.2), 3분 상승률 최소%(기본 0.25), 박스 상단 봉 수(기본 10)
# PUMP_SCANNER_EARLY_VOLUME_RATIO_MIN=1.2
# PUMP_SCANNER_EARLY_RISE_3M_MIN_PCT=0.25
# PUMP_SCANNER_BOX_LOOKBACK_BARS=10
# ORBITALPHA_TRADING_PORT=8787
# 대시보드 실제 Origin (HTTPS 배포 시 반드시 https://… 로 맞출 것 — CORS·크리덴셜 쿠키와 일치해야 함)
# ORBITALPHA_TRADING_DASHBOARD_ORIGIN=http://localhost:3010
# 여러 Origin 허용 시 콤마 구분 (미설정 시 DASHBOARD_ORIGIN 만)
# ORBITALPHA_TRADING_CORS_ORIGINS=https://trade.orbitalpha.kr
# Nginx HTTPS 뒤에서 trust proxy (권장: 1)
# ORBITALPHA_TRADING_TRUST_PROXY=1
# Next→내부 API 구간에서 X-Forwarded-Proto 가 끊기면 세션 쿠키 Secure 를 env 로 강제 (HTTPS 프로덕션 권장: 1)
# ORBITALPHA_TRADING_SESSION_COOKIE_SECURE=1
# (고급) 세션 쿠키 Domain — 잘못 설정 시 로그인 불가
# ORBITALPHA_TRADING_SESSION_COOKIE_DOMAIN=
# (선택) 콤마로 구분 — 해당 마켓은 스캔·WS에서 제외 (예: TRX 노이즈 감소)
# ORBITALPHA_TRADING_EXCLUDE_MARKETS=KRW-TRX
# (선택) signal-monitor 전용 — MVP 4종 외 추가 감시 (콤마 구분). live DEBUG_INCLUDE_UNIVERSE_MARKETS 와 무관.
# Upbit 유효 마켓이 아니면(예: KRW-SOLO) 자동 제외되며 콘솔에 DEBUG_SIGNAL_MONITOR_WATCHLIST_PRUNED_INVALID 로그.
# ORBITALPHA_SIGNAL_MONITOR_EXTRA_MARKETS=KRW-SOL,KRW-ADA,KRW-DOGE
# (선택) 1 이면 프로세스 단일화 락 비활성화 — 동일 머신에서 서버를 두 개 띄울 때만
# ORBITALPHA_TRADING_DISABLE_MONITOR_LOCK=1

# Upbit 429 안정화(보수 설정)
# UPBIT_TICKER_MAX_MARKETS_PER_TICK=15
# UPBIT_TICKER_BATCH_SIZE=5
# UPBIT_TICKER_BATCH_DELAY_MS=1800
# UPBIT_TICKER_429_MAX_ATTEMPTS=2
# UPBIT_TICKER_429_RETRY_DELAY_MS=2000
# PUMP_SCANNER_INTERVAL_MS=60000
# pump 티커 전수 조회 속도(기본: batch 80, 병렬 3, 배치 간 지연 0). 429 시 PUMP_SCANNER_TICKER_PARALLEL=1 등으로 완화.
# PUMP_SCANNER_TICKER_BATCH_SIZE=80
# PUMP_SCANNER_TICKER_PARALLEL=3
# PUMP_SCANNER_TICKER_BATCH_DELAY_MS=0
# 틱 단계별 소요 DEBUG_PUMP_SCANNER_TICK_TIMING (기본 on). 끄려면 PUMP_SCANNER_TIMING_LOG=0
# PUMP_SCANNER_TIMING_LOG=1
# PUMP_SCANNER_CANDLE_MAX_MARKETS_PER_TICK=12
# PUMP_SCANNER_CANDLE_BATCH_SIZE=3
# PUMP_SCANNER_CANDLE_BATCH_DELAY_MS=2000
# PUMP_SCANNER_CANDLE_429_MAX_ATTEMPTS=2
# PUMP_SCANNER_CANDLE_429_BASE_DELAY_MS=1500
# PUMP_SCANNER_CANDLE_CACHE_TTL_MS=120000
# paper 급등 스캐너 — 캔들 분석 대상 유니버스(단기 모멘텀 상위 M). 24h 거래대금 상위 고정 대신 사용.
# PUMP_SCANNER_MOMENTUM_TOP_M=40
# PUMP_SCANNER_MOMENTUM_LOOKBACK_MIN=3
# PUMP_SCANNER_USE_VOLUME_WEIGHT=true
# 유니버스 선별 JSON 로그(DEBUG_UNIVERSE_SELECTION): ORBITALPHA_TRADING_UNIVERSE_DEBUG=1 또는 SCANNER_DEBUG

# Upbit — 서버에만 존재 (대시보드 번들 금지)
# ORBITALPHA_TRADING_UPBIT_ACCESS_KEY=
# ORBITALPHA_TRADING_UPBIT_SECRET_KEY=
# ORBITALPHA_TRADING_MODE=paper
# ORBITALPHA_TRADING_LIVE_ORDER_CONFIRM=false
# live 동시 포지션 cap (전략 엔진 + 주문 엔진 공통). 기본 6.
# LIVE_MAX_POSITIONS_CAP=6
# live 자금 버퍼 비율(수수료/슬리피지/주문 실패 대비). 기본 0.10 (10%).
# LIVE_CAPITAL_BUFFER_RATIO=0.10
# (또는 공용키)
# TRADING_MODE=paper
# LIVE_ORDER_CONFIRM=false
# TRADING_LOGIN_ID=admin
# TRADING_LOGIN_PASSWORD=955104

# (선택) 구버전 호환 — 가능하면 위 ORBITALPHA_TRADING_* 만 사용
# ORBITALPHA_COMPANY_ID=
# ORBITALPHA_SERVICE_ID=
